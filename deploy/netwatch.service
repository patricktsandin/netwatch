# netwatch: continuous network monitor (ADR-0007).
# Install: see deploy/README.md.
[Unit]
Description=netwatch network monitor
Documentation=file:///usr/share/doc/netwatch/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=netwatch
Group=netwatch
ExecStart=/usr/local/bin/netwatch
Environment=NETWATCH_DB=/var/lib/netwatch/netwatch.db
Environment=NETWATCH_LISTEN=127.0.0.1:8732
StateDirectory=netwatch
Restart=on-failure
RestartSec=5

# Exactly the capabilities ADR-0007 allows. Every one is optional: without it, the
# sources that need it are disabled and the daemon says so, rather than failing.
#   CAP_NET_RAW:              gateway ARP/NDP probes (AF_PACKET)
#   CAP_SYSLOG:               /dev/kmsg (kernel.dmesg_restrict=1)
#   CAP_BPF, CAP_PERFMON:     the drop-reason eBPF program
AmbientCapabilities=CAP_NET_RAW CAP_SYSLOG CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_NET_RAW CAP_SYSLOG CAP_BPF CAP_PERFMON
NoNewPrivileges=yes

# Hardening that costs nothing here.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
